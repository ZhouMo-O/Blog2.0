# ============================================================
# 阿里云 OSS 配置
# ------------------------------------------------------------
# 注意：region 需要填「地域 ID」，不是完整域名。
#   ✔ 正确：region=oss-cn-shanghai
#   ✘ 错误：region=oss-cn-shanghai.aliyuncs.com
# 另：本文件是 .env 格式（KEY=value），不要写引号和行尾逗号，
# 否则值会把引号/逗号一起带进去，导致 OSS 报签名或域名错误。
# ============================================================
region=oss-cn-shanghai
accessKeyId=yourAccessKeyId
accessKeySecret=yourAccessKeySecret
bucket=yourBucket

# ---- 邮件通知（评论回复提醒，可选）----
eamailUser=xxxxx@qq.com
emailPassWord=yourSmtpAuthCode

# ---- JWT 签名密钥 ----
token=pleaseChangeThisToARandomString

# ---- 会话签名密钥（未配置时会随机生成，重启即失效）----
SESSION_SECRET=pleaseChangeThisToAnotherRandomString

# ---- 首次启动时的默认管理员（仅在数据库无任何用户时生效，可留空）----
# ADMIN_INIT_USERNAME=starryAdmin
# ADMIN_INIT_PASSWORD=
